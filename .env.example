# Local dev: Vite proxies /nexusai/api to this host.
# Default (unset) is https://monishlabs.com — Hostinger's firewall drops :3000.
# Use a raw API origin only when that port is reachable (local backend):
# VITE_DEV_API_TARGET=http://localhost:3000

# Production (Coolify): the web container's nginx forwards /api to this upstream.
# Set this on the Coolify web service. Defaults to the in-network backend.
# API_UPSTREAM=http://ainexus-api:3000
